{
  "expo": {
    "name": "MotionFrame AI",
    "slug": "motionframe-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "motionframe",
    "plugins": [
      "expo-router",
      "munim-ffmpeg",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MotionFrame AI to select photos for video generation."
        }
      ]
    ],
    "android": {
      "package": "com.motionframe.ai"
    },
    "extra": {
      "backendUrl": "https://motionframe-ai.onrender.com",
      "eas": {
        "projectId": "d09c0be9-ed70-40d8-ab44-a646307ab763"
      }
    }
  }
}
